<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="96"
    android:viewportHeight="96">

    <!-- Outer circle -->
    <path
        android:pathData="M48,24 A24,24 0 1,1 47.99,24 Z"
        android:strokeColor="#D7DBE2"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />

    <!-- Tilted orbit ring (-20 deg around 48,48) -->
    <group
        android:pivotX="48"
        android:pivotY="48"
        android:rotation="-20">
        <path
            android:pathData="M11,48 A37,11 0 1,0 85,48 A37,11 0 1,0 11,48 Z"
            android:strokeColor="#8A919C"
            android:strokeWidth="1.8"
            android:strokeLineCap="round" />
    </group>

    <!-- Orbiting dot -->
    <path
        android:fillColor="#D7DBE2"
        android:pathData="M82.8,36.8 A2.8,2.8 0 1,1 82.79,36.8 Z" />

    <!-- Robot visor -->
    <path
        android:fillColor="#101318"
        android:pathData="M43,37 L53,37 A8,8 0 0,1 61,45 L61,51 A8,8 0 0,1 53,59 L43,59 A8,8 0 0,1 35,51 L35,45 A8,8 0 0,1 43,37 Z"
        android:strokeColor="#D7DBE2"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />

    <!-- Left gradient eye -->
    <path android:pathData="M43.5,45 A3,3 0 1,1 43.49,45 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="46.5"
                android:endY="51"
                android:startX="40.5"
                android:startY="45"
                android:type="linear">
                <item android:color="#7C6CF6" android:offset="0.0" />
                <item android:color="#EC4899" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right gradient eye -->
    <path android:pathData="M52.5,45 A3,3 0 1,1 52.49,45 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="55.5"
                android:endY="51"
                android:startX="49.5"
                android:startY="45"
                android:type="linear">
                <item android:color="#7C6CF6" android:offset="0.0" />
                <item android:color="#EC4899" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>

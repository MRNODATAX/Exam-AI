<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- Mini-Panel (#floatChat) -->
    <LinearLayout
        android:id="@+id/layoutMiniPanel"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_logo_box"
                android:padding="3dp"
                android:src="@drawable/ic_ai_assistant" />

            <TextView
                android:id="@+id/tvMiniHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="ExamAI · Mini Panel"
                android:textColor="@color/txt"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCloseMini"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/dim"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnMiniAutoAnswer"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_gradient"
            android:text="⚡ Auto-Answer Chrome"
            android:textAllCaps="false"
            android:textColor="@color/txt"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMiniChatReply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:maxLines="5"
            android:padding="8dp"
            android:text="Tanya cepat atau tekan Auto-Answer di atas."
            android:textColor="@color/sub"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etMiniChat"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="Tanya AI..."
                android:inputType="text"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:textColor="@color/txt"
                android:textColorHint="@color/dim"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnMiniSend"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_btn_gradient"
                android:text="→"
                android:textColor="@color/txt"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Floating FAB (#fab 56x56) -->
    <LinearLayout
        android:id="@+id/fabContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivFloatingIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_floating_idle"
            android:contentDescription="ExamAI Floating Button"
            android:elevation="8dp"
            android:padding="10dp"
            android:src="@drawable/ic_ai_assistant" />

        <TextView
            android:id="@+id/tvFloatingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="#E6101318"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text="Idle"
            android:textColor="@color/txt"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>

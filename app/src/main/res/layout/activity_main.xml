<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Main App Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header: Logo + Wordmark "ExamAI · by nodata" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_logo_box"
                android:contentDescription="ExamAI Logo"
                android:padding="6dp"
                android:src="@drawable/ic_ai_assistant" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="ExamAI ✦"
                    android:textColor="@color/txt"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeaderGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="by nodata"
                    android:textColor="@color/dim"
                    android:textSize="10.5sp"
                    android:textStyle="italic" />
            </LinearLayout>
        </LinearLayout>

        <!-- Content Area (5 Tabs) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- TAB 1: BERANDA -->
            <ScrollView
                android:id="@+id/tabHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="20dp">

                    <!-- Live Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <View
                            android:id="@+id/dotLive"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_floating_success" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvLiveModel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Model AI Online"
                                android:textColor="@color/txt"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvLiveProvider"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="GEMINI · gemini-2.5-flash"
                                android:textColor="@color/dim"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Izin Sistem -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.14"
                            android:text="IZIN SISTEM"
                            android:textColor="@color/dim"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOverlayStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Izin Overlay: Belum Aktif"
                            android:textColor="@color/bad"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnRequestOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_input"
                            android:text="Aktifkan Izin Overlay"
                            android:textAllCaps="false"
                            android:textColor="@color/txt"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvAccessibilityStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="Accessibility Service: Belum Aktif"
                            android:textColor="@color/bad"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnOpenAccessibility"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_input"
                            android:text="Buka Pengaturan Accessibility"
                            android:textAllCaps="false"
                            android:textColor="@color/txt"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Kontrol Floating Widget -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.14"
                            android:text="FLOATING WIDGET"
                            android:textColor="@color/dim"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnToggleService"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_btn_gradient"
                            android:text="Jalankan Floating Widget"
                            android:textAllCaps="false"
                            android:textColor="@color/txt"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- TAB 2: AUTO-ANSWER -->
            <ScrollView
                android:id="@+id/tabAutoAnswer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto-Answer Chrome"
                            android:textColor="@color/txt"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Membaca soal Google Form di com.android.chrome, mengirim ke AI dengan prompt ketat, lalu mengklik opsi jawaban atau mengisi EditText secara otomatis."
                            android:textColor="@color/sub"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvAutoAnswerDetailStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Status: Menunggu aktivasi Accessibility"
                            android:textColor="@color/warn"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- TAB 3: CHAT -->
            <LinearLayout
                android:id="@+id/tabChat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <ScrollView
                    android:id="@+id/scrollChat"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvChatHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ExamAI Chat siap membantu. Ketik pertanyaan di bawah."
                        android:textColor="@color/sub"
                        android:textSize="13sp" />
                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etChatInput"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:hint="Tanya sesuatu ke AI..."
                        android:inputType="text"
                        android:paddingHorizontal="14dp"
                        android:singleLine="true"
                        android:textColor="@color/txt"
                        android:textColorHint="@color/dim"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnSendChat"
                        android:layout_width="64dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_btn_gradient"
                        android:text="Kirim"
                        android:textAllCaps="false"
                        android:textColor="@color/txt"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- TAB 4: LAPORAN -->
            <LinearLayout
                android:id="@+id/tabLaporan"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Riwayat Auto-Answer"
                        android:textColor="@color/txt"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnClearHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_input"
                        android:paddingHorizontal="12dp"
                        android:text="Hapus"
                        android:textAllCaps="false"
                        android:textColor="@color/sub"
                        android:textSize="11sp" />
                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvHistoryList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Belum ada riwayat jawaban."
                        android:textColor="@color/sub"
                        android:textSize="12.5sp" />
                </ScrollView>
            </LinearLayout>

            <!-- TAB 5: PENGATURAN -->
            <ScrollView
                android:id="@+id/tabSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.14"
                            android:text="KONFIGURASI AI API"
                            android:textColor="@color/dim"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Provider AI"
                            android:textColor="@color/sub"
                            android:textSize="12sp" />

                        <Spinner
                            android:id="@+id/spinnerProvider"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_input"
                            android:paddingHorizontal="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="API Key"
                            android:textColor="@color/sub"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etApiKey"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_input"
                            android:hint="Masukkan API Key"
                            android:inputType="textPassword"
                            android:paddingHorizontal="14dp"
                            android:singleLine="true"
                            android:textColor="@color/txt"
                            android:textColorHint="@color/dim"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Model (opsional, default otomatis)"
                            android:textColor="@color/sub"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etModel"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_input"
                            android:hint="gemini-2.5-flash / gpt-4o-mini"
                            android:inputType="text"
                            android:paddingHorizontal="14dp"
                            android:singleLine="true"
                            android:textColor="@color/txt"
                            android:textColorHint="@color/dim"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:id="@+id/layoutBaseUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Base URL (OmniRoute / Standard)"
                                android:textColor="@color/sub"
                                android:textSize="12sp" />

                            <EditText
                                android:id="@+id/etBaseUrl"
                                android:layout_width="match_parent"
                                android:layout_height="46dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_input"
                                android:hint="https://api.omniroute.ai/v1/chat/completions"
                                android:inputType="textUri"
                                android:paddingHorizontal="14dp"
                                android:singleLine="true"
                                android:textColor="@color/txt"
                                android:textColorHint="@color/dim"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnSaveConfig"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_btn_gradient"
                                android:text="Simpan"
                                android:textAllCaps="false"
                                android:textColor="@color/txt"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnTestApi"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_input"
                                android:text="Tes API Key"
                                android:textAllCaps="false"
                                android:textColor="@color/txt"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvApiTestResult"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text=""
                            android:textColor="@color/sub"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Opacity Slider -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvOpacityLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Transparansi Floating Button: 100%"
                            android:textColor="@color/txt"
                            android:textSize="13sp" />

                        <SeekBar
                            android:id="@+id/seekOpacity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:max="70"
                            android:progress="70" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

        </FrameLayout>

        <!-- Bottom Navigation (#0E1114) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="#0E1114"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <Button
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:text="Beranda"
                android:textAllCaps="false"
                android:textColor="@color/txt"
                android:textSize="11sp" />

            <Button
                android:id="@+id/navAuto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:text="Auto"
                android:textAllCaps="false"
                android:textColor="@color/dim"
                android:textSize="11sp" />

            <Button
                android:id="@+id/navChat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:text="Chat"
                android:textAllCaps="false"
                android:textColor="@color/dim"
                android:textSize="11sp" />

            <Button
                android:id="@+id/navLaporan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:text="Laporan"
                android:textAllCaps="false"
                android:textColor="@color/dim"
                android:textSize="11sp" />

            <Button
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:text="Atur"
                android:textAllCaps="false"
                android:textColor="@color/dim"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Name Gate (#sName, first launch) -->
    <LinearLayout
        android:id="@+id/nameGateOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_logo_box"
            android:padding="12dp"
            android:src="@drawable/ic_ai_assistant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="serif"
            android:text="ExamAI ✦"
            android:textColor="@color/txt"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Masukkan nama Anda untuk memulai"
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etUserName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_input"
            android:gravity="center"
            android:hint="Nama Anda"
            android:inputType="textPersonName"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:textColor="@color/txt"
            android:textColorHint="@color/dim"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnEnterApp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_gradient"
            android:text="Masuk"
            android:textAllCaps="false"
            android:textColor="@color/txt"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Splash Screen (#sp) -->
    <LinearLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/bg_logo_box"
            android:padding="14dp"
            android:src="@drawable/ic_ai_assistant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="serif"
            android:text="ExamAI ✦"
            android:textColor="@color/txt"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="by nodata"
            android:textColor="@color/dim"
            android:textSize="12sp"
            android:textStyle="italic" />

        <ProgressBar
            android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="3dp"
            android:layout_marginTop="18dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/acc" />
    </LinearLayout>

</FrameLayout>
